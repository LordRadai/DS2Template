enum <byte> PartType {
    PartTypeMapPiece = 0,
    PartTypeObject = 1,
    PartTypeWarpHit = 2,
    PartTypeHit = 3,
    PartTypeNavmesh = 4,
    PartTypeConnectHit = 5,
};

typedef struct {
    short unk00;
    byte unk02;
} MAP_PIECE_PARTS_PARAM;

typedef struct {
    uint obj_instance_id;
    short obj_bonfire_id;
} OBJECT_PARTS_PARAM;

typedef struct (int version) {
    uint nvm_group[4];
    ubyte hit_parts_param_sound_space_reverb_type;
    ubyte hit_parts_param_sound_space_delay_type;
    byte hit_parts_param_memory_block_id;
    ubyte hit_parts_param_filter_id;
    ubyte hit_parts_param_hit_filter_id;
    ubyte hit_parts_param_ambient_sfx_attach_type;
    ubyte parts_disable_intrude;
    byte unk17 <hidden=true>; Assert(unk17 == 0);
    uint hit_parts_param_ambient_sfx_id;
    int hit_parts_param_player_light_sfx_id;
    int hit_parts_play_area_id;
    byte hit_parts_param_game_brightness_0;
    byte hit_parts_param_game_brightness_1;
    byte hit_parts_param_ene_wall_memory_block_id_a;
    byte hit_parts_param_ene_wall_memory_block_id_b;
    int hit_parts_param_disp_map_name_id;
    byte hit_parts_param_is_delay_disp_map_name_id;
    byte unk2D <hidden=true>; Assert(unk2D == 0);
    short hit_parts_cube_env_id;
    int hit_parts_camera_ex_follow_param_id;
    byte unk34;
    byte unk35;
    short unk36;
    int hit_parts_param_hit_group_id;
    int unk3C;
    byte unk40;
    byte unk41 <hidden=true>; Assert(unk41 == 0);
    byte unk42 <hidden=true>; Assert(unk42 == 0);
    byte unk43 <hidden=true>; Assert(unk43 == 0);
    int unk44;
} HIT_PARTS_PARAM_ST;


typedef struct {
    int navimesh_group0;
    int navimesh_group1;
    int navimesh_group2;
    int navimesh_group3;
} NAVIMESH_PARTS_PARAM_ST;


typedef struct {
    int connect_hit_parts_param_parent_hit;
    ubyte connect_hit_parts_param_area_no[4];
} CONNECT_HIT_PARTS_PARAM_ST;

typedef struct {
    int warp_hit_parts_param_parent_hit;
    Vector3 warp_hit_parts_param_offset;
} WARP_HIT_PARTS_PARAM_ST;

//------------------------------------------------

typedef struct (int version) {
    local quad start <hidden=true> = FTell();

    Varint parts_name;
    PartType parts_type;
    byte unk09 <hidden=true>; Assert(unk09 == 0);
    short parts_type_idx;
    short parts_model_name;
    short unk0E <hidden=true>; Assert(unk0E == 0);
    Vector3 parts_position;
    Vector3 parts_rotation;
    Vector3 parts_scale;
    uint draw_group[4];
    int unk44; // On collisions, these 4 values match the 4 values in navmesh type data
    int unk48; // Nvm groups?
    int unk4C;
    int unk50;
    uint display_group[4];
    int parts_light_id;
    int parts_fog_id;
    byte parts_disable_fog;
    byte unk6D <hidden=true>; Assert(unk6D == 0);
    byte unk6E <hidden=true>; Assert(unk6E == 0);
    byte unk6F <hidden=true>; Assert(unk6F == 0);
    Varint typeDataOffset;
    if (VARINT_LONG) {
        quad unk78 <hidden=true>; Assert(unk78 == 0);
    }
    
    Assert(parts_name.val > 0);
    FSeek(start + parts_name.val);
    wstring name;
    
    Assert(typeDataOffset.val > 0);
    FSeek(start + typeDataOffset.val);
    switch (parts_type) {
        case PartTypeMapPiece: MAP_PIECE_PARTS_PARAM mapPiece; break;
        case PartTypeObject: OBJECT_PARTS_PARAM object; break;
        case PartTypeWarpHit: WARP_HIT_PARTS_PARAM_ST warp_hit; break;
        case PartTypeHit: HIT_PARTS_PARAM_ST hit(version); break;
        case PartTypeNavmesh: NAVIMESH_PARTS_PARAM_ST navimesh; break;
        case PartTypeConnectHit: CONNECT_HIT_PARTS_PARAM_ST connectCollision; break;
        default: Assert(false);
    }
} PARTS_PARAM_ST <read=ReadPart>;

wstring ReadPart(PARTS_PARAM_ST& part) {
    string str;
    if (false && part.parts_type == PartTypeMapPiece) {
        SPrintf(str, "%2i %2i %i ", part.parts_type, part.mapPiece.unk00, part.mapPiece.unk02);
    } else if (false && part.parts_type == PartTypeObject) {
        SPrintf(str, "%2i %8Xh %8Xh ", part.parts_type, part.object.unk00, part.object.unk04);
    } else if (part.parts_type == PartTypeNavmesh) {
        SPrintf(str, "%2i %8Xh %8Xh %8Xh %8Xh ", part.parts_type, part.navimesh.navimesh_group0, part.navimesh.navimesh_group1, part.navimesh.navimesh_group2, part.navimesh.navimesh_group3);
    } else if (false && part.parts_type == PartTypeConnectCollision) {
        SPrintf(str, "%2i %8Xh %8Xh ", part.parts_type, part.connectCollision.unk08, part.connectCollision.unk0C);
    } else {
        SPrintf(str, "%2i %8Xh %8Xh %8Xh %8Xh ", part.parts_type, part.unk44, part.unk48, part.unk4C, part.unk50);
    }
    return str + part.name;
}