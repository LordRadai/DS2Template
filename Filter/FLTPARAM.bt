//------------------------------------------------
//--- 010 Editor v7.0.2 Binary Template
//
//      File: FLTPARAM.bt
//   Authors: TKGP, Radai
//   Version: 2.0
//   Purpose: DS2 / DS2 SotFS filter params (.fltparam)
//  Category: Dark Souls
// File Mask: *.fltparam
//  ID Bytes: 66 69 6C 74
//   History: 2.0 Field and type names taken from the game:
//                FilterParamVer3::KatanaFilterParamReaderImplVer3
//                GXMetaInfoCollection::META_INFO_TYPE, DLMT::DL_VECTOR*AL, DLMT::DL_COLOR_32
//                Handles versions 0, 1 and 2. PC files are little endian, PS3 files big endian.
//------------------------------------------------

LittleEndian();
if (ReadUInt(4) > 0xFF)
    BigEndian();

enum <ubyte> META_INFO_TYPE
{
    META_INFO_TYPE_NONE = 0,
    META_INFO_TYPE_S8,
    META_INFO_TYPE_S16,
    META_INFO_TYPE_S32,
    META_INFO_TYPE_S64,
    META_INFO_TYPE_U8,
    META_INFO_TYPE_U16,
    META_INFO_TYPE_U32,
    META_INFO_TYPE_U64,
    META_INFO_TYPE_F32,
    META_INFO_TYPE_F64,
    META_INFO_TYPE_BOOL,
    META_INFO_TYPE_VECTOR2,
    META_INFO_TYPE_VECTOR3,
    META_INFO_TYPE_VECTOR4,
    META_INFO_TYPE_COLOR32,
};

struct FILTER_PARAM_HEADER
{
    char   m_Magic[4]; Assert(m_Magic == "filt", "Not a fltparam file");
    uint32 m_Version;  Assert(m_Version <= 2, "Unknown fltparam version");
    uint32 m_Reserved08;
    uint32 m_FilterNum;
    uint32 m_IdSetNum;
    uint32 m_FilterOffsetTableOffset <format=hex>;  // u32[m_FilterNum], offsets into the filter records
    uint32 m_FilterRecordBase <format=hex>;
    uint32 m_ParamOffsetTableOffset <format=hex>;   // u32 per param, offsets into the param records
    uint32 m_ParamRecordBase <format=hex>;
    uint32 m_ValueBase <format=hex>;
    if (m_Version == 0)
    {
        uint32 m_IdSetBase <format=hex>;
        uint32 m_Reserved2C[5];
    }
    else
    {
        uint32 m_ValueIdBase <format=hex>;
        uint32 m_IdSetBase <format=hex>;
        if (m_Version >= 2)
        {
            uint32 m_EditedFilterNum;
            uint32 m_EditedTableOffset <format=hex>;
            uint32 m_EditedIdBase <format=hex>;
        }
        else
        {
            uint32 m_Reserved30[3];
        }
        uint32 m_Reserved3C;
    }
} header <bgcolor=cLtRed>;

// Values are stored in fixed-size slots: vectors always take 16 bytes, unused components are zero.
// Each param's value array is padded to 4 bytes.
struct DL_VECTOR2AL { float x; float y; uint32 pad[2]; Assert(pad[0] == 0 && pad[1] == 0, "Vector2 padding not zero"); };
struct DL_VECTOR3AL { float x; float y; float z; uint32 pad; Assert(pad == 0, "Vector3 padding not zero"); };
struct DL_VECTOR4AL { float x; float y; float z; float w; };
struct DL_COLOR_32  { ubyte b; ubyte g; ubyte r; ubyte a; };

struct PARAM_RECORD
{
    uint32 m_ValueOffset <format=hex>;          // into m_ValueBase
    if (header.m_Version >= 1)
        uint32 m_ValueIdOffset <format=hex>;    // into m_ValueIdBase
    META_INFO_TYPE m_Type;
    ubyte  m_ValueNum;
    uint16 m_Reserved; Assert(m_Reserved == 0, "Param record reserved field not zero");
    string m_Name;                              // Shift-JIS

    local quad pos = FTell();

    if (m_ValueNum > 0)
    {
        FSeek(header.m_ValueBase + m_ValueOffset);
        SetBackColor(cLtBlue);
        switch (m_Type)
        {
            case META_INFO_TYPE_S8:      byte         m_Values[m_ValueNum]; break;
            case META_INFO_TYPE_S16:     int16        m_Values[m_ValueNum]; break;
            case META_INFO_TYPE_S32:     int32        m_Values[m_ValueNum]; break;
            case META_INFO_TYPE_U8:      ubyte        m_Values[m_ValueNum]; break;
            case META_INFO_TYPE_U16:     uint16       m_Values[m_ValueNum]; break;
            case META_INFO_TYPE_U32:     uint32       m_Values[m_ValueNum]; break;
            case META_INFO_TYPE_F32:     float        m_Values[m_ValueNum]; break;
            case META_INFO_TYPE_BOOL:    ubyte        m_Values[m_ValueNum]; break;
            case META_INFO_TYPE_VECTOR2: DL_VECTOR2AL m_Values[m_ValueNum] <optimize=true>; break;
            case META_INFO_TYPE_VECTOR3: DL_VECTOR3AL m_Values[m_ValueNum] <optimize=true>; break;
            case META_INFO_TYPE_VECTOR4: DL_VECTOR4AL m_Values[m_ValueNum] <optimize=true>; break;
            case META_INFO_TYPE_COLOR32: DL_COLOR_32  m_Values[m_ValueNum] <optimize=true>; break;
            default: Assert(false, "Unsupported META_INFO_TYPE");
        }

        if (header.m_Version >= 1)
        {
            FSeek(header.m_ValueIdBase + m_ValueIdOffset);
            SetBackColor(cRed);
            uint32 m_ValueIds[m_ValueNum];      // filter id of each value (0..15 are the slots)
        }
    }

    FSeek(pos);
};

struct PARAM_ENTRY
{
    uint32 m_RecordOffset <format=hex>;         // into m_ParamRecordBase
    local quad pos = FTell();
    FSeek(header.m_ParamRecordBase + m_RecordOffset);
    PARAM_RECORD m_Record <bgcolor=cAqua>;
    FSeek(pos);
};

struct FILTER_RECORD
{
    uint32 m_ParamNum;
    uint32 m_ParamTableOffset <format=hex>;     // byte offset into m_ParamOffsetTableOffset
    string m_Name;                              // Shift-JIS

    local quad pos = FTell();
    FSeek(header.m_ParamOffsetTableOffset + m_ParamTableOffset);
    PARAM_ENTRY m_Params[m_ParamNum] <optimize=false>;
    FSeek(pos);
};

struct FILTER_ENTRY
{
    uint32 m_RecordOffset <format=hex>;         // into m_FilterRecordBase
    local quad pos = FTell();
    FSeek(header.m_FilterRecordBase + m_RecordOffset);
    FILTER_RECORD m_Record <bgcolor=cLtGreen>;
    FSeek(pos);
};

FSeek(header.m_FilterOffsetTableOffset);
FILTER_ENTRY filters[header.m_FilterNum] <optimize=false>;

// GetIdSetByIndex(i) = m_IdSetBase + i * (m_FilterNum + 1). GetIdSet(id) searches m_Id.
struct ID_SET
{
    ubyte m_Id;
    ubyte m_FilterIds[header.m_FilterNum];      // filter id (slot) per filter, indexed like filters[]
};

FSeek(header.m_IdSetBase);
ID_SET idSets[header.m_IdSetNum] <bgcolor=cYellow, optimize=true>;

if (header.m_Version >= 2)
{
    // GetEditedId(filter, i) finds the entry whose m_FilterIndex == filter and returns m_EditedIds[i]
    struct EDITED_FILTER
    {
        uint32 m_FilterIndex;
        uint32 m_EditedIdNum;
        uint32 m_EditedIdOffset <format=hex>;   // into m_EditedIdBase

        local quad pos = FTell();
        FSeek(header.m_EditedIdBase + m_EditedIdOffset);
        uint32 m_EditedIds[m_EditedIdNum] <bgcolor=cLtGray>;
        FSeek(pos);
    };

    FSeek(header.m_EditedTableOffset);
    EDITED_FILTER editedFilters[header.m_EditedFilterNum] <bgcolor=cGray, optimize=false>;
}
