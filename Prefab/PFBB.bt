//------------------------------------------------
//--- 010 Editor v9.0.2 Binary Template
//
//   File: PFBB.bt
//   Authors: Radai
//   Version: 0.3
//   Purpose: DS2 prefab binary format (PC, 64-bit little endian).
//   Category: Dantelion
//   File Mask: *.pfbbin
//   ID Bytes: 50 46 42 42 46 52 50 47 32
//   History:
//     0.2 Full layout: parts, assets, attributes, chunks,
//         FormDesign blobs, EventAction flows (event / branch / action
//         nodes), relocation table.
//     0.3 FormDesign typing switches on (owner, attribute id) and on the
//         action id; added attr 0x65 physics, parts attr 5, actions
//         5017/5018, operator / event param / action id enums; fixed
//         Timer, Sound and Bullet sizes from all 435 PC files.
//         5017 mapped as DummyPolyRegion, 5018 as ModelFade.
//------------------------------------------------

LittleEndian();
BitfieldRightToLeft();

//------------------------------------------------
// Enums
//------------------------------------------------

enum <uint> PF_CHUNK_TYPE
{
    PF_CHUNK_FORM_DESIGN = 0,       // -> PF_PFBBIN_FORM_DESIGN_CHUNK_BLOCK (raw bytes, endian-agnostic, e.g. FormDesign)
    PF_CHUNK_EVENT_ACTION   = 1,    // -> PF_PFBBIN_EVENT_ACTION_CHUNK_BLOCK (EventAction flows)
};

enum <uint> PF_NODE_TYPE
{
    PF_NODE_EVENT   = 0,    // pData -> uint eventId
    PF_NODE_BRANCH  = 1,    // pData -> PF_BRANCH
    PF_NODE_ACTION = 2,     // pData -> PF_PFBBIN_ACTION_BLOCK
};

// Who owns the FormDesign chunk being parsed. The file stores no type for a
// chunk: the reader picks the struct from (owner, id), where id is the
// attribute id for assets/parts and the action id for action arguments.
enum <uint> PF_CHUNK_OWNER
{
    PF_OWNER_NONE   = 0,
    PF_OWNER_ASSET  = 1,    // PF_PFBBIN_ASSET_BLOCK attribute
    PF_OWNER_PARTS  = 2,    // PF_PFBBIN_PARTS_BLOCK attribute
    PF_OWNER_ACTION = 3,    // PF_PFBBIN_ACTION_BLOCK argument
};

// Asset attribute ids (asset type 0x63; every PC asset has exactly these two)
enum <uint> PF_ASSET_ATTR
{
    PF_ASSET_ATTR_PHYSICS = 0x65,   // FormDesign PF_FD_PHYSICS (MapObjStateActComponent::OnStartState)
    PF_ASSET_ATTR_STATE   = 0x66,   // FormDesign PF_FD_STATE + EventAction flows
};

// Parts attribute ids (every PC parts entry has exactly these three)
enum <uint> PF_PARTS_ATTR
{
    PF_PARTS_ATTR_ASSET = 1,        // FormDesign PF_FD_PARTS_ASSET (initial asset)
    PF_PARTS_ATTR_PRS   = 2,        // FormDesign PF_FD_PARTS_PRS
    PF_PARTS_ATTR_FLOW  = 5,        // FormDesign float + EventAction flows
};

// Action ids (AppPrefabSystem::Initialize)
enum <uint> PF_ACTION_ID
{
    PF_ACTION_SMASH             = 5000,
    PF_ACTION_TRANSFIGURE       = 5001,
    PF_ACTION_SFX               = 5003,
    PF_ACTION_BREAK             = 5004,
    PF_ACTION_TIMER             = 5005,
    PF_ACTION_TOUCH             = 5006,
    PF_ACTION_BULLET            = 5007,
    PF_ACTION_PLAYANIM          = 5008,
    PF_ACTION_DAMAGE            = 5009,
    PF_ACTION_HIDE              = 5010,
    PF_ACTION_SOUND             = 5011,
    PF_ACTION_RESETPOSE         = 5012,
    PF_ACTION_INVINCIBLE        = 5013,
    PF_ACTION_REGION            = 5014,
    PF_ACTION_KEYGUIDE          = 5015,
    PF_ACTION_SHOW              = 5016,
    PF_ACTION_DUMMYPOLY_REGION  = 5017,
    PF_ACTION_MODEL_FADE        = 5018,
};

// Comparisons push a Boolean.
enum <uint> PF_OPERATOR
{
    PF_OP_ADD_REAL        = 0,
    PF_OP_SUB_REAL        = 1,
    PF_OP_MUL_REAL        = 2,
    PF_OP_DIV_REAL        = 3,
    PF_OP_NEG_REAL        = 4,
    PF_OP_GREATER_REAL    = 5,
    PF_OP_GREATEREQ_REAL  = 6,
    PF_OP_LESS_REAL       = 7,
    PF_OP_LESSEQ_REAL     = 8,
    PF_OP_EQ_REAL         = 9,
    PF_OP_EQ_BOOLEAN      = 10,
    PF_OP_NOTEQ_REAL      = 11,
    PF_OP_NOTEQ_BOOLEAN   = 12,
    PF_OP_INV_BOOLEAN     = 13,
    PF_OP_AND_BOOLEAN     = 14,
    PF_OP_OR_BOOLEAN      = 15,
};

enum <uint> PF_FUNCTION
{
    PF_FUNC_XREAL = 1024,
    PF_FUNC_XBOOL = 1025,
};

enum <uint> PF_EVENT_PARAM
{
    Damaged_Hp = 2000, Damaged_Destructed, Damaged_Spread, Damaged_OldHp,
    Damaged_Normal, Damaged_Magic, Damaged_Fire, Damaged_Thunder, Damaged_Dark,
    Damaged_Special, Damaged_Poison, Damaged_Bleed, Damaged_WeaponBreak,
    Damaged_Curse, Damaged_Burning, Damaged_DeadlyPoison, Damaged_OilWet,
    Damaged_Impact = 2020,
    Timer_Value = 2100,
    UpperDurability_PlayerCount = 2200, UpperDurability_TotalCount,
    UpperDurability_IsFirstPlayer, UpperDurability_CoopCount,
    UpperDurability_VersusCount,
    StateJudge_LocalValue = 2205,   // StateActCtrl+0x12 = requested target stateId
    StateJudge_EventFlag1, StateJudge_EventFlag2, StateJudge_EventFlag3,
    StateJudge_Looped, StateJudge_ActionFinished, StateJudge_Extra,
    StateJudge_Acquired, StateJudge_CancelDisable, StateJudge_PlayAnimRate,
    StateJudge_Unacquired,
    Touched_HavokImpact = 2300,
};

// RPN token types (PfEvaluationFlowImpl::_EvaluateCondition). The condition is
// true when the value left on top of the stack is non-zero.
enum <uint> PF_TOKEN_TYPE
{
    PF_TOKEN_LITERAL     = 0,  // push PfAnyData literal (float or int bits)
    PF_TOKEN_OPERATOR    = 1,  // PF_OPERATOR
    PF_TOKEN_EVENT_PARAM = 2,  // PF_EVENT_PARAM, pushes the accessor value
    PF_TOKEN_FUNCTION    = 3,  // PF_FUNCTION
};

//------------------------------------------------
// Helpers
//------------------------------------------------

// Flow nodes form a DAG (true and false paths can share nodes), so each node is
// expanded once and later references only show the offset.
local int64 g_visited[4096];

// Type key of the FormDesign chunk being parsed: (owner, id). Kept in globals
// because PF_CHUNK is reached recursively through forward-declared structs.
// Attribute and action blocks save, set and restore them.
local PF_CHUNK_OWNER g_fdOwner = PF_OWNER_NONE;
local uint           g_fdId    = 0;
local PF_CHUNK_OWNER g_attrOwner = PF_OWNER_NONE;  // set by the asset / parts block
local int            g_visitedCount = 0;

int IsVisited(int64 off)
{
    local int i;
    for (i = 0; i < g_visitedCount; i++)
        if (g_visited[i] == off)
            return true;
    return false;
}

void MarkVisited(int64 off)
{
    if (g_visitedCount < 4096)
    {
        g_visited[g_visitedCount] = off;
        g_visitedCount++;
    }
}

typedef struct {
    uint64 ptr <format=hex>;
    if (ptr != 0) {
        local int64 cPos = FTell();
        FSeek(ptr);
        wstring text;
        FSeek(cPos);
    }
} WStringPtr <read=ReadWStringPtr>;

wstring ReadWStringPtr(WStringPtr &s)
{
    if (s.ptr == 0)
        return "<null>";
    return s.text;
}

//------------------------------------------------
// Header
//------------------------------------------------

typedef struct {
    char magic[10]; Assert(magic == "PFBBFRPG2");
    short unk0A; Assert(unk0A == 0);
    int unk0C; Assert(unk0C == 0);
    int unk10; Assert(unk10 == 0);
    ubyte byteOrderFlag;
    ubyte bitOrderFlag;
    short unk16;
    short version; Assert(version == 1);    // TestPfbbinHeaderValidation requires 1
    short unk1A; Assert(unk1A == 1);
    short unk1C; Assert(unk1C == 1);
    short unk1E; Assert(unk1E == 1);
    uint64 pRelocTable <format=hex>;   	    // -> PF_RELOC_TABLE (not itself relocated)
    uint64 pParts <format=hex>;             // -> PF_PFBBIN_PARTS_BLOCK[partsCount]
    uint64 pAssets <format=hex>;            // -> PF_PFBBIN_ASSET_BLOCK[assetCount]
    ushort partsCount;
    ushort assetCount;
    uint pad3C <hidden=true>;
} PF_PFBBIN_HEADER <bgcolor=cLtRed>;

//------------------------------------------------
// Flow graph (EventAction)
//------------------------------------------------

struct PF_NODE;

typedef struct {
    PF_TOKEN_TYPE type;
    switch (type) {
        case PF_TOKEN_LITERAL:     float          value; break;
        case PF_TOKEN_OPERATOR:    PF_OPERATOR    value; break;
        case PF_TOKEN_EVENT_PARAM: PF_EVENT_PARAM value; break;
        case PF_TOKEN_FUNCTION:    PF_FUNCTION    value; break;
        default:                   uint           value; break;
    }
} PF_TOKEN <read=ReadToken>;

string ReadToken(PF_TOKEN &t)
{
    if (t.type == PF_TOKEN_LITERAL)
        return Str("float %g", t.value);
    if (t.type == PF_TOKEN_OPERATOR)
        return "op " + EnumToString(t.value);
    if (t.type == PF_TOKEN_EVENT_PARAM)
        return "param " + EnumToString(t.value);
    if (t.type == PF_TOKEN_FUNCTION)
        return "func " + EnumToString(t.value);
    return Str("type %u: %u", t.type, t.value);
}

// PF_PFBBIN_CONDITION_BLOCK: if the expression is true evaluation continues
// at pThen, otherwise at the owning node's pNext.
struct PF_BRANCH {
    uint tokenCount;
    uint pad04 <hidden=true>;
    uint64 pThen <format=hex>;      // -> PF_NODE
    uint64 pTokens <format=hex>;    // -> PF_TOKEN[tokenCount]

    local int64 ret = FTell();
    if (pTokens != 0 && tokenCount > 0) {
        FSeek(pTokens);
        PF_TOKEN tokens[tokenCount] <optimize=false>;
    }
    if (pThen != 0 && !IsVisited(pThen)) {
        FSeek(pThen);
        struct PF_NODE then;
    }
    FSeek(ret);
};

struct PF_CHUNK;

struct PF_PFBBIN_ACTION_BLOCK {
    PF_ACTION_ID actionId;
    uint argCount;
    uint64 pArgs <format=hex>;      // -> PF_CHUNK[argCount]

    local int64 ret = FTell();
    if (pArgs != 0 && argCount > 0) {
        local PF_CHUNK_OWNER savedOwner = g_fdOwner;
        local uint           savedId    = g_fdId;
        g_fdOwner = PF_OWNER_ACTION;
        g_fdId    = actionId;
        FSeek(pArgs);
        struct PF_CHUNK args[argCount] <optimize=false>;
        g_fdOwner = savedOwner;
        g_fdId    = savedId;
    }
    FSeek(ret);
};

// PF_PFBBIN_EVAL_FLOW_NODE_BLOCK
struct PF_NODE {
    local int64 self = FTell();
    MarkVisited(self);

    uint64 pNext <format=hex>;      // -> PF_NODE (next in chain), or 0
    PF_NODE_TYPE type;
    uint pad0C <hidden=true>;
    uint64 pData <format=hex>;      // depends on type

    local int64 ret = FTell();
    if (pData != 0) {
        FSeek(pData);
        switch (type) {
            case PF_NODE_EVENT:     uint eventId; break;
            case PF_NODE_BRANCH:    struct PF_BRANCH branch;   break;
            case PF_NODE_ACTION:    struct PF_PFBBIN_ACTION_BLOCK action; break;
        }
    }
    if (pNext != 0 && !IsVisited(pNext)) {
        FSeek(pNext);
        struct PF_NODE next;
    }
    FSeek(ret);
};

string ReadNode(struct PF_NODE &n)
{
    if (n.type == PF_NODE_EVENT && exists(n.eventId))
        return Str("Event %d", n.eventId);
    if (n.type == PF_NODE_BRANCH)
        return "Branch";
    if (n.type == PF_NODE_ACTION && exists(n.action))
        return "Action " + EnumToString(n.action.actionId);
    return EnumToString(n.type);
}

//------------------------------------------------
// Values
//------------------------------------------------

//------------------------------------------------
// FormDesign payloads
//------------------------------------------------

typedef struct {
    ubyte physicsType;              // 0..6, remapped to MapObjStatus::PhysicsType
                                    // {0,1,2,4,5,6,3} -> SetPhysicsTypeForcibly
    ubyte changeToMovable;          // 1 -> ChangeToMovable (only o16_2010 on PC)
} PF_FD_PHYSICS;

// Asset attribute 0x66, chunk 0 -> StateActGraphMaker::AddState
typedef struct {
    ubyte stateId;                  // compared by StateJudge_LocalValue
    ubyte flag01;                   // bool, last AddState argument
    ubyte flag02;                   // bool, 7th AddState argument
    ubyte multiPlayType;            // StateActMultiPlayType (0..3 seen, 3 only in o35_110x)
    uint  eventFlag[3];             // AddState eventFlag 1..3 (StateJudge_EventFlag1..3);
                                    // [1] and [2] are 0 in every PC file
    // modelVariant is not stored: it is parsed from the .sib file name ("_N")
} PF_FD_STATE;

// Parts attribute 1 (GetAssetAttributeChunk)
typedef struct {
    uint assetHash <format=hex>;    // initial asset / state
} PF_FD_PARTS_ASSET;

// Parts attribute 2 (GetPrsAttributeChunk), 0x1C bytes
typedef struct {
    float position[3];
    float rotation[3];
    float scale;                    // identity (0,0,0 / 0,0,0 / 1.0) in every PC file
} PF_FD_PARTS_PRS;

// Parts attribute 5, chunk 0 (chunk 1 is EventAction flows)
typedef struct {
    float value;                    // 1.0 in every PC file
} PF_FD_PARTS_FLOAT;

// 5001 Transfigure (state change)
typedef struct {
    uint assetHash <format=hex>;    // target asset; its 0x66 stateId is used
} PF_FD_TRANSFIGURE;

// 5003 Sfx -> AddCommand_Sfx(CreateType, PositionType, short, uint sfxId, uint,
//                            bool, int, ShowEffectType, float, HideEffectType, float)
typedef struct {
    uint createType   : 1;          // StateActCreateType (must be 0 when source == 1)
    uint source       : 2;          // 1 = explicit sfxId, 2 = ObjGraphicParam resident slot
    uint positionType : 5;          // StateActPositionType (0, 1, 2)
    uint unk          : 4;
    uint slot         : 20;         // resident sfx slot (source 2)
    uint slot2;                     // second resident slot lookup (source 2)
    int  sfxId;                     // source 1
    int  unk0C;                     // int argument
    float showTime;                 // show effect time
    float hideTime;                 // hide effect time
} PF_FD_SFX;

// 5000 Smash -> AddCommand_Smash(float, float, float, float, PositionType)
typedef struct {
    float value0;
    uint  positionType;             // 0, 3 or other selects the PositionType passed
    float value1;
    float value2;
    float value3;
} PF_FD_SMASH;

// 5005 Timer -> AddCommand_Timer(float)
typedef struct {
    float time;
    uint  unk04;                    // 0 in every PC file
} PF_FD_TIMER;

// 5007 Bullet -> AddCommand_Bullet(CreateType, uint, uint)
typedef struct {
    ubyte source;                   // 1 = explicit ids, 2 = from ObjInsParam (+4/+8)
    ubyte createType;               // StateActCreateType (0, 1)
    ushort pad02 <hidden=true>;
    uint  bulletArg0;               // source 1 (bullet param id), 0 for source 2
    uint  bulletArg1;               // source 1 (bullet param id), 0 for source 2
    int   unk0C;                    // -1 in every PC file
} PF_FD_BULLET;

// 5008 PlayAnim -> AddCommand_PlayAnim(int, bool, InitialFrameType, float)
//              or AddCommand_RandomPlayAnim(int, bool, float, uint, uint)
typedef struct {
    int  animId;
    uint loop             : 1;      // bool argument
    uint unk1             : 1;
    uint initialFrameType : 2;      // StateActAnimInitialFrameType, 3 = RandomPlayAnim
    uint source           : 2;      // 1 = explicit animId, 2 = ObjGraphicParam
    uint unk6             : 1;
    uint randomMin        : 10;     // RandomPlayAnim
    uint randomMax        : 10;     // RandomPlayAnim
    uint pad              : 5 <hidden=true>;
    float value;                    // float argument (frame / rate)
} PF_FD_PLAYANIM;

// 5010 Hide / 5016 Show -> AddCommand_Hide/Show(float) or (float x4)
typedef struct {
    float value;
    uint  use0  : 1;                // 4-float form: argument N = value if set, else -1.0
    uint  use1  : 1;
    uint  use2  : 1;
    uint  use3  : 1;
    uint  multi : 28;               // non-zero selects the 4-float form
} PF_FD_SHOWHIDE;

// 5011 Sound -> AddCommand_Sound(CreateType, PositionType, ushort, int)
typedef struct {
    short  positionType;            // StateActPositionType (0, 1, 2)
    ushort unk02;                   // ushort argument
    int    soundId;
    short  createType;              // StateActCreateType (0, 1)
    short  unk0A;                   // -1 in every PC file
} PF_FD_SOUND;

// 5012 ResetPose -> AddCommand_ResetPose(ResetPoseModeType, int)
typedef struct {
    uint mode;                      // StateActResetPoseModeType
    int  value;
} PF_FD_RESETPOSE;

// 5014 Region -> AddCommand_Sphere/Cylinder/BoxRegion
typedef struct {
    float offset[3];
    float angle;                    // yaw, normalized
    uint  reserved  : 1;            // asserts if set
    uint  unk       : 8;            // unsigned char argument
    uint  condition : 2;            // StateActRegionConditionType
    uint  shape     : 2;            // 0 sphere, 1 cylinder, 2 box
    uint  pad       : 19 <hidden=true>;
    float sphereRadius;
    float cylinderRadius;
    float cylinderHeight;
    float boxSize[3];
} PF_FD_REGION;

// 5015 KeyGuide -> AddCommand_KeyGuide(int, int)
typedef struct {
    int value0;
    int value1;
} PF_FD_KEYGUIDE;

// 5017 DummyPolyRegion (PC only, o35/o36/o85) -> AddCommand_Sphere/Cylinder/BoxRegion
// with the PC-only (dummyPolyId, flag) arguments. Same 0x2C layout as Region,
// different bit packing. When dummyPolyId != 0 the volume is placed on the
// owner model's dummy poly and offset/angle are ignored.
typedef struct {
    float offset[3];                // positionSource 0 only
    float angle;                    // yaw, normalized (positionSource 0 only)
    uint  positionSource : 4;       // 0 = offset/angle, 1 = dummy poly
    uint  unk            : 8;       // unsigned char argument
    uint  condition      : 4;       // StateActRegionConditionType
    uint  dummyPolyId    : 8;       // positionSource 1 (byte +0x12)
    uint  shape          : 7;       // 0 sphere, 1 cylinder, 2 box
    uint  flag           : 1;       // positionSource 1, stored at MapStateActLocation+0xB0 bit 1 (reader not traced)
    float sphereRadius;
    float cylinderRadius;
    float cylinderHeight;
    float boxSize[3];
} PF_FD_DUMMYPOLY_REGION;

// 5018 ModelFade (PC only, o37_11xx) -> cmd 0xD -> IStateActEntity +0x110.
// Instant version of the TimeAct MapTimeActTrackExtra 0x7acdd fade (same model byte +0x202).
typedef struct {
    float value;                    // 0.0 or 1.0 in all files
} PF_FD_MODEL_FADE;

// 5006 Touch takes no argument. 5013 Invincible has one 0-byte FormDesign.
// 5004 Break and 5009 Damage assert in the StateAct action maker.

typedef struct {
    uint64 size;
    uint64 pData <format=hex>;

    local int64 ret = FTell();
    if (pData != 0 && size > 0) {
        FSeek(pData);
        uchar data[size] <format=hex>;
        FSeek(pData);
        if (g_fdOwner == PF_OWNER_ASSET) {
            switch (g_fdId) {
                case PF_ASSET_ATTR_PHYSICS: PF_FD_PHYSICS physics; break;
                case PF_ASSET_ATTR_STATE:   PF_FD_STATE   state;   break;
            }
        }
        else if (g_fdOwner == PF_OWNER_PARTS) {
            switch (g_fdId) {
                case PF_PARTS_ATTR_ASSET: PF_FD_PARTS_ASSET asset; break;
                case PF_PARTS_ATTR_PRS:   PF_FD_PARTS_PRS   prs;   break;
                case PF_PARTS_ATTR_FLOW:  PF_FD_PARTS_FLOAT value; break;
            }
        }
        else if (g_fdOwner == PF_OWNER_ACTION) {
            switch (g_fdId) {
                case PF_ACTION_SMASH:       PF_FD_SMASH       smash;       break;
                case PF_ACTION_TRANSFIGURE: PF_FD_TRANSFIGURE transfigure; break;
                case PF_ACTION_SFX:         PF_FD_SFX         sfx;         break;
                case PF_ACTION_TIMER:       PF_FD_TIMER       timer;       break;
                case PF_ACTION_BULLET:      PF_FD_BULLET      bullet;      break;
                case PF_ACTION_PLAYANIM:    PF_FD_PLAYANIM    playAnim;    break;
                case PF_ACTION_HIDE:
                case PF_ACTION_SHOW:        PF_FD_SHOWHIDE    showHide;    break;
                case PF_ACTION_SOUND:       PF_FD_SOUND       sound;       break;
                case PF_ACTION_RESETPOSE:   PF_FD_RESETPOSE   resetPose;   break;
                case PF_ACTION_REGION:      PF_FD_REGION      region;      break;
                case PF_ACTION_KEYGUIDE:    PF_FD_KEYGUIDE    keyGuide;    break;
                case PF_ACTION_DUMMYPOLY_REGION: PF_FD_DUMMYPOLY_REGION dummyPolyRegion; break;
                case PF_ACTION_MODEL_FADE:  PF_FD_MODEL_FADE  modelFade;   break;
            }
        }
        // Unknown (owner, id) pairs only show the raw `data` bytes above.
    }
    FSeek(ret);
} PF_PFBBIN_FORM_DESIGN_CHUNK_BLOCK;

// Array of event nodes (type PF_NODE_EVENT), each the head of one flow.
typedef struct {
    uint count;
    uint pad04 <hidden=true>;
    uint64 pEvents <format=hex>;    // -> PF_NODE[count] (contiguous)

    local int64 ret = FTell();
    if (pEvents != 0 && count > 0) {
        FSeek(pEvents);
        struct PF_NODE events[count] <optimize=false, read=ReadNode>;
    }
    FSeek(ret);
} PF_PFBBIN_EVENT_ACTION_CHUNK_BLOCK;

struct PF_CHUNK {
    PF_CHUNK_TYPE type;
    uint pad04 <hidden=true>;
    uint64 pData <format=hex>;

    local int64 ret = FTell();
    if (pData != 0) {
        FSeek(pData);
        switch (type) {
            case PF_CHUNK_FORM_DESIGN: PF_PFBBIN_FORM_DESIGN_CHUNK_BLOCK blob;       break;
            case PF_CHUNK_EVENT_ACTION:   PF_PFBBIN_EVENT_ACTION_CHUNK_BLOCK flows; break;
        }
    }
    FSeek(ret);
};

//------------------------------------------------
// Attributes / assets / parts
//------------------------------------------------

// The id is scoped by the owner: see PF_ASSET_ATTR and PF_PARTS_ATTR.
typedef struct {
    local PF_CHUNK_OWNER owner = g_attrOwner;   // read functions run later, so keep a copy
    uint id;
    uint valueCount;
    uint64 pValues <format=hex>;    // -> PF_CHUNK[valueCount]

    local int64 ret = FTell();
    if (pValues != 0 && valueCount > 0) {
        local PF_CHUNK_OWNER savedOwner = g_fdOwner;
        local uint           savedId    = g_fdId;
        g_fdOwner = g_attrOwner;
        g_fdId    = id;
        FSeek(pValues);
        struct PF_CHUNK values[valueCount] <optimize=false>;
        g_fdOwner = savedOwner;
        g_fdId    = savedId;
    }
    FSeek(ret);
} PF_PFBBIN_ATTRIBUTE_BLOCK <read=ReadAttribute>;

string ReadAttribute(PF_PFBBIN_ATTRIBUTE_BLOCK &a)
{
    local string n = "";
    if (a.owner == PF_OWNER_ASSET) {
        if (a.id == PF_ASSET_ATTR_PHYSICS) n = " Physics";
        else if (a.id == PF_ASSET_ATTR_STATE) n = " State";
    } else if (a.owner == PF_OWNER_PARTS) {
        if (a.id == PF_PARTS_ATTR_ASSET) n = " Asset";
        else if (a.id == PF_PARTS_ATTR_PRS) n = " Prs";
        else if (a.id == PF_PARTS_ATTR_FLOW) n = " Flow";
    }
    return Str("%d%s (%u values)", a.id, n, a.valueCount);
}

typedef struct {
    uint hash <format=hex>;         // referenced by state change commands
    uint pad04 <hidden=true>;
    WStringPtr name;
    WStringPtr path;                // source .sib
    uint type;                      // 0x63
    uint attributeCount;
    uint64 pAttributes <format=hex>;

    local int64 ret = FTell();
    if (pAttributes != 0 && attributeCount > 0) {
        g_attrOwner = PF_OWNER_ASSET;
        FSeek(pAttributes);
        PF_PFBBIN_ATTRIBUTE_BLOCK attributes[attributeCount] <optimize=false>;
    }
    FSeek(ret);
} PF_PFBBIN_ASSET_BLOCK <read=ReadAsset>;

wstring ReadAsset(PF_PFBBIN_ASSET_BLOCK &a)
{
    return ReadWStringPtr(a.name);
}

// NOTE: the reloc table lists 0x674 for the name pointer, but on PC the
// pointer is at +0x08 (0x678) after 4 bytes of padding.
typedef struct {
    uint hash <format=hex>;
    uint pad04 <hidden=true>;
    WStringPtr name;                // "OBJ"
    uint type;                      // 1
    uint attributeCount;
    uint64 pAttributes <format=hex>;

    local int64 ret = FTell();
    if (pAttributes != 0 && attributeCount > 0) {
        g_attrOwner = PF_OWNER_PARTS;
        FSeek(pAttributes);
        PF_PFBBIN_ATTRIBUTE_BLOCK attributes[attributeCount] <optimize=false>;
    }
    FSeek(ret);
} PF_PFBBIN_PARTS_BLOCK <bgcolor=cLtGreen>;

typedef struct {
    uint count;
    uint offsets[count] <format=hex>;
} PF_RELOC_TABLE <bgcolor=cLtGray>;

//------------------------------------------------
// Main
//------------------------------------------------

PF_PFBBIN_HEADER header;

FSeek(header.pAssets);
PF_PFBBIN_ASSET_BLOCK assets[header.assetCount] <optimize=false, bgcolor=cLtYellow>;

FSeek(header.pParts);
PF_PFBBIN_PARTS_BLOCK parts[header.partsCount] <optimize=false>;

FSeek(header.pRelocTable);
PF_RELOC_TABLE relocs;
